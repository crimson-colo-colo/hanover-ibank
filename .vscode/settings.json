{
	"files.eol": "\n",
	"editor.formatOnSave": true,
	"editor.codeActionsOnSave": {
		"source.organizeImports.biome": "explicit"
	},
	"files.watcherExclude": {
		"**/routeTree.gen.ts": true,
		"**/server/generated/prisma/**": true,
		"**/node_modules/**": true,
		"**/dist/**": true
	},
	"search.exclude": {
		"**/routeTree.gen.ts": true,
		"**/server/generated/prisma/**": true,
		"**/node_modules/**": true,
		"**/dist/**": true
	},
	"files.readonlyInclude": {
		"**/routeTree.gen.ts": true,
		"**/server/generated/prisma/**": true,
		"**/node_modules/**": true,
		"**/dist/**": true
	},
	"[javascript]": {
		"editor.defaultFormatter": "biomejs.biome"
	},
	"[javascriptreact]": {
		"editor.defaultFormatter": "biomejs.biome"
	},
	"[typescript]": {
		"editor.defaultFormatter": "biomejs.biome"
	},
	"[typescriptreact]": {
		"editor.defaultFormatter": "biomejs.biome"
	},
	"[json]": {
		"editor.defaultFormatter": "biomejs.biome"
	},
	"[jsonc]": {
		"editor.defaultFormatter": "biomejs.biome"
	},
	"[css]": {
		"editor.defaultFormatter": "biomejs.biome"
	}

}
