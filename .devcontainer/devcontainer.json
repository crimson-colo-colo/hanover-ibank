{
	"name": "Team C devcontainer",
	"image": "mcr.microsoft.com/devcontainers/javascript-node:22-bookworm",
	"forwardPorts": [3000, 24678, 5555, 9000, 9001],
	"features": {
		"ghcr.io/devcontainers/features/common-utils:2": {
			"configureZshAsDefaultShell": true
		},
		"ghcr.io/devcontainers/features/docker-in-docker:2": {},
		"ghcr.io/shyim/devcontainers-features/bun:0": {},
		"ghcr.io/devcontainers/features/github-cli:1": {}
	},
	"customizations": {
		"vscode": {
			"extensions": [
				"biomejs.biome",
				"prisma.prisma",
				"ms-azuretools.vscode-docker",
				"editorconfig.editorconfig",
				"esbenp.prettier-vscode",
				"tamasfe.even-better-toml",
				"oven.bun-vscode"
			],
			"settings": {
				"editor.defaultFormatter": "biomejs.biome",
				"editor.formatOnSave": true,
				"editor.codeActionsOnSave": {
					"source.organizeImports": "always"
				}
			}
		}
	},
	"postCreateCommand": "bun install & bun_pid=$!; docker compose pull --ignore-pull-failures & docker_pid=$!; wait \"$bun_pid\" \"$docker_pid\"; bun run db:seed",
	"remoteEnv": {
		"VITE_AUTH0_DOMAIN": "${localEnv:VITE_AUTH0_DOMAIN}",
		"VITE_AUTH0_CLIENT_ID": "${localEnv:VITE_AUTH0_CLIENT_ID}",
		"VITE_AUTH0_AUDIENCE": "${localEnv:VITE_AUTH0_AUDIENCE}",
		"AUTH0_CLIENT_SECRET": "${localEnv:AUTH0_CLIENT_SECRET}",
		"AUTH0_TENANT": "${localEnv:AUTH0_TENANT}",
		"AUTH0_MANAGEMENT_CLIENT_ID": "${localEnv:AUTH0_MANAGEMENT_CLIENT_ID}",
		"AUTH0_MANAGEMENT_CLIENT_SECRET": "${localEnv:AUTH0_MANAGEMENT_CLIENT_SECRET}",
		"OPENROUTER_API_KEY": "${localEnv:OPENROUTER_API_KEY}"
	},
	"portsAttributes": {
		"3000": {
			"label": "Webserver",
			"requireLocalPort": true
		},
		"Vite WS/SSE": {
			"label": "Vite HMR",
			"requireLocalPort": true
		},
		"9000": {
			"label": "Minio Probably",
			"requireLocalPort": true
		},
		"9001": {
			"label": "Minio",
			"requireLocalPort": true
		},
		"24678": {
			"label": "Vite HMR",
			"requireLocalPort": true
		}
	}
}
