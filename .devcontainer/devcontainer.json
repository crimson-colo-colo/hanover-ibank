{
	"name": "Team C devcontainer",
	"image": "mcr.microsoft.com/devcontainers/javascript-node:22-bookworm",
	"forwardPorts": [3000, 24678, 5555, 9001],
	"features": {
		"ghcr.io/devcontainers/features/common-utils:2": {
			"configureZshAsDefaultShell": true
		},
		"ghcr.io/devcontainers/features/docker-in-docker:2": {},
		"ghcr.io/shyim/devcontainers-features/bun:0": {},
		"ghcr.io/devcontainers/features/github-cli:1": {}
	},
	"customizations": {
		"vscode": {
			"extensions": [
				"biomejs.biome",
				"prisma.prisma",
				"ms-azuretools.vscode-docker",
				"editorconfig.editorconfig",
				"esbenp.prettier-vscode",
				"tamasfe.even-better-toml"
			],
			"settings": {
				"editor.defaultFormatter": "biomejs.biome",
				"editor.formatOnSave": true,
				"editor.codeActionsOnSave": {
					"source.organizeImports": "always"
				}
			}
		}
	},
	"postCreateCommand": "(bun install &) && docker compose pull --ignore-pull-failures && docker compose up -d",
	"remoteEnv": {
		"VITE_AUTH0_DOMAIN": "${localEnv:VITE_AUTH0_DOMAIN}",
        "VITE_AUTH0_CLIENT_ID": "${localEnv:VITE_AUTH0_CLIENT_ID}",
        "VITE_AUTH0_AUDIENCE": "${localEnv:VITE_AUTH0_AUDIENCE}",
        "AUTH0_CLIENT_SECRET": "${localEnv:AUTH0_CLIENT_SECRET}",
        "AUTH0_TENANT": "${localEnv:AUTH0_TENANT}",
        "AUTH0_MANAGEMENT_CLIENT_ID": "${localEnv:AUTH0_MANAGEMENT_CLIENT_ID}",
        "AUTH0_MANAGEMENT_CLIENT_SECRET": "${localEnv:AUTH0_MANAGEMENT_CLIENT_SECRET}",
	}
}
