{
	"name": "project",
	"private": true,
	"type": "module",
	"imports": {
		"#/*": "./src/*"
	},
	"scripts": {
		"dev": "NODE_ENV=development bun --watch server/main.dev.ts",
		"start": "NODE_ENV=production bun server/main.ts",
		"build": "vite build",
		"preview": "vite preview",
		"test": "vitest run",
		"format": "biome format",
		"lint": "biome lint",
		"check": "biome check",
		"db:generate": "dotenvx run -qf .env.development -- prisma generate",
		"db:start": "docker compose -p cs3733 up --wait",
		"db:logs": "docker compose -p cs3733 logs -f",
		"db:stop": "docker compose -p cs3733 down",
		"db:migrate": "dotenvx run -qf .env.development -- bun prisma migrate",
		"db:seed": "NODE_ENV=development bun ./prisma/seed.ts"
	},
	"dependencies": {
		"@mantine/core": "^9.0.0",
		"@mantine/hooks": "^9.0.0",
		"@prisma/adapter-pg": "^7.6.0",
		"@t3-oss/env-core": "^0.13.11",
		"@trpc/server": "^11.16.0",
		"express": "^5.2.1",
		"morgan": "^1.10.1",
		"superjson": "^2.2.6",
		"zod": "^4.3.6"
	},
	"devDependencies": {
		"@biomejs/biome": "2.4.5",
		"@dotenvx/dotenvx": "^1.59.1",
		"@faker-js/faker": "^10.4.0",
		"@rolldown/plugin-babel": "^0.2.2",
		"@tailwindcss/typography": "^0.5.16",
		"@tailwindcss/vite": "^4.1.18",
		"@tanstack/devtools-vite": "^0.6.0",
		"@tanstack/react-devtools": "^0.10.0",
		"@tanstack/react-form": "^1.28.6",
		"@tanstack/react-query": "^5.95.2",
		"@tanstack/react-query-devtools": "^5.95.2",
		"@tanstack/react-router": "^1.168.10",
		"@tanstack/react-router-devtools": "^1.166.11",
		"@tanstack/router-plugin": "^1.132.0",
		"@testing-library/dom": "^10.4.1",
		"@testing-library/react": "^16.3.0",
		"@trpc/client": "^11.16.0",
		"@trpc/tanstack-react-query": "^11.16.0",
		"@types/express": "^5.0.6",
		"@types/morgan": "^1.9.10",
		"@types/node": "^25.5.0",
		"@types/pg": "^8.20.0",
		"@types/react": "^19.2.0",
		"@types/react-dom": "^19.2.0",
		"@vitejs/plugin-react": "^6.0.1",
		"jsdom": "^29.0.1",
		"lucide-react": "^1.7.0",
		"prisma": "^7.6.0",
		"react": "^19.2.0",
		"react-dom": "^19.2.0",
		"tailwindcss": "^4.1.18",
		"typescript": "^6.0.2",
		"vite": "^8.0.3",
		"vitest": "^4.1.2"
	}
}
