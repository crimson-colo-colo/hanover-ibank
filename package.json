{
	"name": "project",
	"private": true,
	"type": "module",
	"imports": {
		"#/*": "./src/*"
	},
	"scripts": {
		"dev": "NODE_ENV=development bun --watch server/main.dev.ts",
		"start": "NODE_ENV=production bun server/main.ts",
		"build": "vite build",
		"preview": "vite preview",
		"test": "vitest run",
		"format": "biome format",
		"lint": "biome lint",
		"check": "biome check",
		"db:generate": "dotenvx run -qf .env.development -- prisma generate",
		"db:start": "docker compose -p cs3733 up --wait",
		"db:logs": "docker compose -p cs3733 logs -f",
		"db:stop": "docker compose -p cs3733 down",
		"db:migrate": "dotenvx run -qf .env.development -- prisma migrate",
		"db:seed": "NODE_ENV=development bun db:stop && (docker volume rm cs3733_minio_data cs3733_db_data || true) && bun db:start && bun ./scripts/sleep.ts && bun db:migrate deploy && bun ./prisma/seed.ts",
		"cli": "bun run cli/cli.ts",
		"email:dev": "NODE_ENV=development email dev -d ./server/emails -p 3001"
	},
