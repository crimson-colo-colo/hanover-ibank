{
	"name": "project",
	"private": true,
	"type": "module",
	"imports": {
		"#/*": "./src/*"
	},
	"scripts": {
		"dev": "NODE_ENV=development bun --watch server/main.dev.ts",
		"start": "NODE_ENV=production bun server/main.ts",
		"build": "vite build",
		"preview": "vite preview",
		"test": "vitest run",
		"format": "biome format",
		"lint": "biome lint",
		"check": "biome check",
		"db:generate": "dotenvx run -qf .env.development -- prisma generate",
		"db:start": "docker compose -p cs3733 up --wait",
		"db:logs": "docker compose -p cs3733 logs -f",
		"db:stop": "docker compose -p cs3733 down",
		"db:migrate": "dotenvx run -qf .env.development -- prisma migrate",
		"db:seed": "NODE_ENV=development bun db:stop && docker volume rm cs3733_minio_data cs3733_db_data && bun db:start && bun ./scripts/sleep.ts && bun db:migrate deploy && bun ./prisma/seed.ts",
		"cli": "API_URL='http://localhost:3000' bun run cli/cli.ts"
	},
	"dependencies": {
		"@auth0/auth0-api-js": "^1.4.0",
		"@mantine/dates": "^9.0.0",
		"@prisma/adapter-pg": "^7.6.0",
		"@prisma/client": "^7.6.0",
		"@t3-oss/env-core": "^0.13.11",
		"@trpc/server": "^11.16.0",
		"auth0": "^5.5.0",
		"dayjs": "^1.11.20",
		"express": "^5.2.1",
		"express-oauth2-jwt-bearer": "^1.7.4",
		"fflate": "^0.8.2",
		"jose": "^6.2.2",
		"minio": "^8.0.7",
		"morgan": "^1.10.1",
		"pino": "^10.3.1",
		"superjson": "^2.2.6",
		"uuid": "^13.0.0",
		"zod": "^4.3.6"
	},
	"devDependencies": {
		"@auth0/auth0-react": "^2.16.1",
		"@auth0/auth0-spa-js": "^2.18.3",
		"@biomejs/biome": "2.4.6",
		"@dotenvx/dotenvx": "^1.59.1",
		"@faker-js/faker": "^10.4.0",
		"@fontsource-variable/plus-jakarta-sans": "^5.2.8",
		"@fontsource/miranda-sans": "^5.2.1",
		"@mantine/core": "^9.0.0",
		"@mantine/dropzone": "^9.0.1",
		"@mantine/form": "^9.0.0",
		"@mantine/hooks": "^9.0.0",
		"@mantine/notifications": "^9.0.1",
		"@react-buddy/ide-toolbox": "^2.4.0",
		"@rolldown/plugin-babel": "^0.2.2",
		"@tabler/icons-react": "^3.41.1",
		"@tailwindcss/typography": "^0.5.16",
		"@tailwindcss/vite": "^4.1.18",
		"@tanstack/devtools-vite": "^0.6.0",
		"@tanstack/react-devtools": "^0.10.0",
		"@tanstack/react-form": "^1.28.6",
		"@tanstack/react-query": "^5.95.2",
