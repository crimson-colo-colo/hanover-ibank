{
	"include": [
		"vite.config.ts",
		"server/**/*.ts",
		"server/**/*.tsx",
		"cli/**/*.ts",
		"prisma/**/*.ts",
		"shared/**/*.ts",
		"scripts/**/*.ts"
	],
	"exclude": ["server/**/*.worker.ts"],
	"compilerOptions": {
		"tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
		"target": "esnext",
		"lib": ["ESNext"],
		"module": "ESNext",
		"types": ["node", "bun"],
		"skipLibCheck": true,

		/* Bundler mode */
		"moduleResolution": "bundler",
		"allowImportingTsExtensions": true,
		"verbatimModuleSyntax": true,
		"moduleDetection": "force",
		"noEmit": true,
		"jsx": "react-jsx",

		/* Linting */
		"strict": true,
		"erasableSyntaxOnly": true,
		"noUncheckedSideEffectImports": true,
		"paths": {
			"@shared/*": ["./shared/*"]
		},
	},
}
