generator client {
  provider = "prisma-client"
  output   = "../server/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum EmployeeRole {
  BusinessAnalyst
  Underwriter
  Admin
}

enum ThreadStatus {
  Open
  Resolved
  Archived
}

model Employee {
  id                String            @id
  role              EmployeeRole
  content           Content[]         @relation("Owner")
  favorite          FavoriteContent[]
  checkedOutContent Content[]         @relation("CheckedOutContent")

  createdThreads  ContentThread[] @relation("ThreadCreatedBy")
  resolvedThreads ContentThread[] @relation("ThreadResolvedBy")
  comments        ThreadComment[] @relation("CommentAuthor")
}

model Content {
  id               String            @id @default(cuid())
  title            String
  description      String?
  status           ContentStatus     @default(Incomplete)
  type             ContentType
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  lastModifiedDate DateTime
  expirationDate   DateTime
  /// S3 Object ID
  objectId         String?
  /// URL for links
  url              String?
  ownerId          String
  owner            Employee          @relation("Owner", fields: [ownerId], references: [id])
  tags             ContentTag[]
  favoritedBy      FavoriteContent[]
  checkedOutById   String?
  checkedOutBy     Employee?         @relation("CheckedOutContent", fields: [checkedOutById], references: [id])
  threads          ContentThread[]
}

model ContentThread {
  id           String       @id @default(cuid())
  contentId    String
  title        String?
  sectionLabel String?
  status       ThreadStatus @default(Open)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  resolvedAt   DateTime?
  createdById  String
  resolvedById String?

  content    Content         @relation(fields: [contentId], references: [id], onDelete: Cascade)
  createdBy  Employee        @relation("ThreadCreatedBy", fields: [createdById], references: [id])
  resolvedBy Employee?       @relation("ThreadResolvedBy", fields: [resolvedById], references: [id])
  comments   ThreadComment[]
}

model ThreadComment {
  id        String    @id @default(cuid())
  threadId  String
  authorId  String
  body      String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  editedAt  DateTime?
  deletedAt DateTime?

  thread ContentThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  author Employee      @relation("CommentAuthor", fields: [authorId], references: [id])
}

model Tag {
  name     String
  category TagCategory

  contents ContentTag[]

  @@id([category, name])
}

model ContentTag {
  content     Content     @relation(fields: [contentId], references: [id], onDelete: Cascade)
  contentId   String
  tag         Tag         @relation(fields: [tagCategory, tagName], references: [category, name])
  tagCategory TagCategory
  tagName     String

  @@id([contentId, tagCategory, tagName])
}

enum TagCategory {
  DocumentType // Workflow or Reference
  IntendedAudience // Underwriter or Business Analyst
  Custom // Custom tag created by user
}

model FavoriteContent {
  content    Content  @relation(fields: [contentId], references: [id])
  contentId  String
  employee   Employee @relation(fields: [employeeId], references: [id])
  employeeId String

  @@id([contentId, employeeId])
}

enum ContentStatus {
  Incomplete
  UnderReview
  Complete
}

enum ContentType {
  Object
  Link
}
