generator client {
  provider = "prisma-client"
  output   = "../server/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id    String @id @default(uuid())
  email String @unique
}

model Content {
  id       String    @id @default(uuid())
  title    String
  document Document?
}

model Document {
  id              String          @id @default(uuid())
  title           String
  expirationDate  DateTime?
  status          DocumentStatus  @default(PENDING)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  content         Content         @relation(fields: [id], references: [id])
  objectId        String
}

enum DocumentStatus {
  PENDING
  NEEDS_WORK
  APPROVED
  REJECTED
}
