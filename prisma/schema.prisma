generator client {
  provider = "prisma-client"
  output   = "../server/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum EmployeeRole {
  BusinessAnalyst
  Underwriter
}

model Employee {
  id        String       @id @default(cuid())
  email     String       @unique
  name      String
  avatarUrl String
  role      EmployeeRole @default(Underwriter)
  content   Content[]
}

model Content {
  id               String        @id @default(cuid())
  title            String
  description      String
  documentType     DocumentType
  type             ContentType
  status           ContentStatus @default(Incomplete)
  lastModifiedDate DateTime      @updatedAt
  expirationDate   DateTime
  /// S3 Object ID
  objectId         String?
  /// URL for links
  url              String?
  ownerId          String
  owner            Employee      @relation(fields: [ownerId], references: [id])
}

// new to confirm status being just placeholders
enum ContentStatus {
  Incomplete
  UnderReview
  Complete
}

enum DocumentType {
  Workflow
  Reference
}

enum ContentType {
  Object
  Link
}
