generator client {
  provider = "prisma-client"
  output   = "../server/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Employee {
  id                String            @id
  role              EmployeeRole
  checkedOutContent Content[]         @relation("CheckedOutContent")
  content           Content[]         @relation("Owner")
  favorite          FavoriteContent[]
  activity          UserActivity[]
}

model Content {
  id               String            @id @default(cuid())
  title            String
  description      String?
  type             ContentType
  /// S3 Object ID
  objectId         String?
  /// URL for links
  url              String?
  ownerId          String
  expirationDate   DateTime
  lastModifiedDate DateTime
  status           ContentStatus     @default(Incomplete)
  createdAt        DateTime          @default(now())
  checkedOutById   String?
  updatedAt        DateTime          @updatedAt
  checkedOutBy     Employee?         @relation("CheckedOutContent", fields: [checkedOutById], references: [id])
  owner            Employee          @relation("Owner", fields: [ownerId], references: [id])
  tags             ContentTag[]
  favoritedBy      FavoriteContent[]
  embeddings       Embedding[]
}

model Tag {
  name     String
  category TagCategory
  contents ContentTag[]

  @@id([category, name])
}

model ContentTag {
  contentId   String
  tagCategory TagCategory
  tagName     String
  content     Content     @relation(fields: [contentId], references: [id], onDelete: Cascade)
  tag         Tag         @relation(fields: [tagCategory, tagName], references: [category, name])

  @@id([contentId, tagCategory, tagName])
}

model FavoriteContent {
  contentId  String
  employeeId String
  content    Content  @relation(fields: [contentId], references: [id])
  employee   Employee @relation(fields: [employeeId], references: [id])

  @@id([contentId, employeeId])
}

model UserActivity {
  timestamp  DateTime
  employeeId String
  path       String
  count      Int      @default(1)
  day        DateTime
  hour       DateTime
  employee   Employee @relation(fields: [employeeId], references: [id])

  @@id([timestamp, employeeId, path])
}

model Embedding {
  hash      Bytes                 @id
  embedding Unsupported("vector")
  content  Content[]
}

enum EmployeeRole {
  BusinessAnalyst
  Underwriter
  Admin
  ActuarialAnalyst
  ExlOperations
  BusinessOperations
}

enum TagCategory {
  DocumentType
  IntendedAudience
  Custom
}

enum ContentStatus {
  Incomplete
  UnderReview
  Complete
}

enum ContentType {
  Object
  Link
}
