generator client {
  provider = "prisma-client"
  output   = "../server/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id    String @id @default(uuid())
  email String @unique
}

enum EmployeeRole {
  Underwriter
  BusinessAnalyst
}
// new to confirm status being just placeholders
enum ContentStatus {
  Incomplete
  UnderReview
  Complete
}
enum ContentType {
  Workflow
  Reference
}

model Employee {
  email     String       @id
  name      String
  role      EmployeeRole @default(Underwriter)
  documents Document[]
}
model Document {
  url              String        @id
  ownerEmail       String
  owner            Employee      @relation(fields: [ownerEmail], references: [email])
  documentName     String        @unique
  status           ContentStatus @default(incomplete)
  type             ContentType
  lastModifiedDate DateTime      @updatedAt
  expirationDate   DateTime
}
