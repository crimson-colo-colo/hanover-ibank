generator client {
  provider = "prisma-client"
  output   = "../server/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum EmployeeRole {
  BusinessAnalyst
  Underwriter
  Admin
}

model Employee {
  id       String            @id
  role     EmployeeRole
  content  Content[]
  favorite FavoriteContent[]
}

model Content {
  id               String                 @id @default(cuid())
  title            String
  description      String?
  status           ContentStatus          @default(Incomplete)
  createdAt        DateTime               @default(now())
  lastModifiedDate DateTime               @updatedAt
  expirationDate   DateTime
  /// S3 Object ID
  objectId         String?
  /// URL for links
  url              String?
  ownerId          String
  owner            Employee               @relation(fields: [ownerId], references: [id])
  tags             ContentTagsOnContent[]
  favoritedBy      FavoriteContent[]
}

model ContentTag {
  name     String
  category TagCategory

  contents ContentTagsOnContent[]

  @@id([category, name])
}

model ContentTagsOnContent {
  content     Content     @relation(fields: [contentID], references: [id])
  contentID   String
  tag         ContentTag  @relation(fields: [tagCategory, tagName], references: [category, name])
  tagCategory TagCategory
  tagName     String

  @@id([contentID, tagCategory, tagName])
}

enum TagCategory {
  DocumentType //Workflow or Reference
  ContentType //Object or Link
  IntendedAudience //Underwriter or Business Analyst
  Custom //Custom tag created by user
}

model FavoriteContent {
  content    Content  @relation(fields: [contentId], references: [id])
  contentId  String
  employee   Employee @relation(fields: [employeeId], references: [id])
  employeeId String

  @@id([contentId, employeeId])
}

enum ContentStatus {
  Incomplete
  UnderReview
  Complete
}
