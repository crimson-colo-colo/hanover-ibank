generator client {
    provider = "prisma-client"
    output   = "../server/generated/prisma"
}

datasource db {
    provider = "postgresql"
}

enum EmployeeRole {
    BusinessAnalyst
    Underwriter
    Admin
}

model Employee {
    id                String            @id
    role              EmployeeRole
    content           Content[]         @relation("Owner")
    favorite          FavoriteContent[]
    checkedOutContent Content[]         @relation("CheckedOutContent")
    activity          UserActivity[]
}

model Content {
    id               String            @id @default(cuid())
    title            String
    description      String?
    status           ContentStatus     @default(Incomplete)
    type             ContentType
    createdAt        DateTime          @default(now())
    updatedAt        DateTime          @updatedAt
    lastModifiedDate DateTime
    expirationDate   DateTime
    /// S3 Object ID
    objectId         String?
    /// URL for links
    url              String?
    ownerId          String
    owner            Employee          @relation("Owner", fields: [ownerId], references: [id])
    tags             ContentTag[]
    favoritedBy      FavoriteContent[]
    checkedOutById   String?
    checkedOutBy     Employee?         @relation("CheckedOutContent", fields: [checkedOutById], references: [id])
}

model Tag {
    name     String
    category TagCategory

    contents ContentTag[]

    @@id([category, name])
}

model ContentTag {
    content     Content     @relation(fields: [contentId], references: [id], onDelete: Cascade)
    contentId   String
    tag         Tag         @relation(fields: [tagCategory, tagName], references: [category, name])
    tagCategory TagCategory
    tagName     String

    @@id([contentId, tagCategory, tagName])
}

enum TagCategory {
    DocumentType // Workflow or Reference
    IntendedAudience // Underwriter or Business Analyst
    Custom // Custom tag created by user
}

model FavoriteContent {
    content    Content  @relation(fields: [contentId], references: [id])
    contentId  String
    employee   Employee @relation(fields: [employeeId], references: [id])
    employeeId String

    @@id([contentId, employeeId])
}

enum ContentStatus {
    Incomplete
    UnderReview
    Complete
}

enum ContentType {
    Object
    Link
}

model UserActivity {
    timestamp  DateTime @default(now())
    employeeId String
    employee   Employee @relation(fields: [employeeId], references: [id])
    path       String
    count      Int      @default(1)

    @@id([timestamp, employeeId])
}
